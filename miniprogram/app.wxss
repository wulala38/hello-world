page {
  background-color: #FFF8DC;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.text-primary {
  color: #8B4513;
}

.text-secondary {
  color: #DAA520;
}

.text-dark {
  color: #2F1810;
}

.text-light {
  color: #F5DEB3;
}

.bg-primary {
  background-color: #8B4513;
}

.bg-secondary {
  background-color: #F5DEB3;
}

.bg-gold {
  background-color: #DAA520;
}

.bg-cream {
  background-color: #FFF8DC;
}

.btn-primary {
  background-color: #8B4513;
  color: white;
  border: none;
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary {
  background-color: #F5DEB3;
  color: #8B4513;
  border: 2rpx solid #8B4513;
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.btn-gold {
  background-color: #DAA520;
  color: white;
  border: none;
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.1);
}

.card-title {
  font-size: 36rpx;
  color: #8B4513;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 40rpx;
  color: #8B4513;
  font-weight: bold;
  margin: 32rpx 24rpx 16rpx;
}

.horizontal-line {
  height: 2rpx;
  background-color: #DAA520;
  margin: 24rpx;
}

.icon-small {
  width: 48rpx;
  height: 48rpx;
}

.icon-medium {
  width: 64rpx;
  height: 64rpx;
}

.icon-large {
  width: 96rpx;
  height: 96rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #DAA520;
}

.badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #DAA520;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.progress-bar {
  height: 16rpx;
  background-color: #F5DEB3;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #DAA520;
  transition: width 0.3s ease;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 48rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #F5DEB3;
  border-top-color: #8B4513;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in {
  animation: fadeIn 0.5s ease;
}

.decorative-border {
  border: 4rpx solid #DAA520;
  border-radius: 16rpx;
  position: relative;
}

.decorative-border::before,
.decorative-border::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background-color: #DAA520;
  border-radius: 50%;
}

.decorative-border::before {
  top: -12rpx;
  left: -12rpx;
}

.decorative-border::after {
  bottom: -12rpx;
  right: -12rpx;
}

.ancient-pattern {
  background-image: url('data:image/svg+xml,%3Csvg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M20 20.5V18H0v-2h20v-2.5a17.5 17.5 0 1 1 0 5z" fill="%23DAA520" fill-opacity="0.05"/%3E%3C/svg%3E');
  background-repeat: repeat;
}

.status-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: inline-block;
}

.status-connected {
  background-color: #52c41a;
}

.status-disconnected {
  background-color: #ff4d4f;
}

.status-connecting {
  background-color: #faad14;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: white;
  border-radius: 16rpx;
  padding: 48rpx;
  margin: 48rpx;
  max-width: 600rpx;
  width: calc(100% - 96rpx);
}

.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(47, 24, 16, 0.9);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
  z-index: 9999;
  font-size: 28rpx;
}
