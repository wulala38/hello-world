.header-section {
  background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
  padding: 32rpx 24rpx 48rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2F1810;
}

.category-section {
  padding: 24rpx 0;
  background-color: #FFF8DC;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 24rpx;
}

.category-item {
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  background-color: white;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.category-item.active {
  background-color: #8B4513;
  border-color: #8B4513;
}

.category-item.active .category-text {
  color: white;
}

.category-text {
  font-size: 26rpx;
  color: #8B4513;
  font-weight: bold;
}

.knowledge-list {
  padding: 24rpx;
}

.knowledge-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.knowledge-card:active {
  transform: scale(0.98);
}

.knowledge-card.favorite {
  border-left: 6rpx solid #ff4d4f;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.level-badge {
  display: flex;
  align-items: center;
  background-color: #FFF8DC;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.level-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.level-title {
  font-size: 24rpx;
  color: #8B4513;
  font-weight: bold;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.favorite-btn {
  font-size: 32rpx;
}

.card-content {
  margin-bottom: 16rpx;
}

.knowledge-title {
  font-size: 32rpx;
  color: #2F1810;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.knowledge-preview {
  font-size: 26rpx;
  color: #5D4037;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  padding-top: 16rpx;
  border-top: 2rpx solid #F5DEB3;
}

.read-more {
  font-size: 26rpx;
  color: #DAA520;
  font-weight: bold;
}

.ancient-decoration {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  opacity: 0.05;
}

.pattern {
  font-size: 100rpx;
  color: #8B4513;
}

.empty-state {
  padding: 100rpx 48rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #2F1810;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #8B4513;
}
