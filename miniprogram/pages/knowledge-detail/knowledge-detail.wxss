.header-section {
  padding: 64rpx 32rpx;
  color: white;
  text-align: center;
}

.level-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.level-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.level-title {
  font-size: 40rpx;
  font-weight: bold;
}

.content-section {
  padding: 32rpx 24rpx;
  margin-top: -32rpx;
}

.knowledge-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 69, 19, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.knowledge-title {
  font-size: 36rpx;
  color: #2F1810;
  font-weight: bold;
  flex: 1;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 36rpx;
}

.knowledge-content {
  margin-bottom: 24rpx;
}

.content-text {
  font-size: 28rpx;
  color: #5D4037;
  line-height: 2;
}

.knowledge-diagram {
  background-color: #FFF8DC;
  border-radius: 16rpx;
  padding: 32rpx;
}

.diagram-placeholder {
  text-align: center;
}

.diagram-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.diagram-label {
  font-size: 24rpx;
  color: #8B4513;
}

.ancient-story-section,
.related-section,
.quiz-prompt-section {
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 36rpx;
  color: #8B4513;
  font-weight: bold;
}

.story-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
}

.story-title {
  font-size: 32rpx;
  color: #DAA520;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.story-content {
  font-size: 26rpx;
  color: #5D4037;
  line-height: 1.8;
}

.related-list {
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
}

.related-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #F5DEB3;
  transition: background-color 0.2s ease;
}

.related-item:last-child {
  border-bottom: none;
}

.related-item:active {
  background-color: #FFF8DC;
}

.related-title {
  font-size: 28rpx;
  color: #5D4037;
}

.related-arrow {
  font-size: 32rpx;
  color: #DAA520;
}

.quiz-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.quiz-content {
  display: flex;
  align-items: center;
}

.quiz-icon {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.quiz-info {
  flex: 1;
}

.quiz-title {
  font-size: 28rpx;
  color: #2F1810;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.quiz-desc {
  font-size: 24rpx;
  color: #8B4513;
}

.btn-quiz {
  padding: 24rpx;
  background-color: #DAA520;
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
}
