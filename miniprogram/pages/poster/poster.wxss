.poster-preview {
  background-color: #F5DEB3;
  padding: 48rpx 24rpx;
  display: flex;
  justify-content: center;
}

.preview-frame {
  background-color: white;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 69, 19, 0.2);
}

.poster-canvas {
  width: 600rpx;
  height: 900rpx;
  border-radius: 12rpx;
}

.action-section {
  padding: 32rpx 24rpx;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  background-color: white;
  border: 3rpx solid #8B4513;
  color: #8B4513;
}

.action-btn.primary {
  background-color: #8B4513;
  color: white;
  border: none;
}

.action-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-weight: bold;
}

.tips-section {
  text-align: center;
  padding: 20rpx;
  background-color: #FFF8DC;
  border-radius: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8B4513;
}

.share-preview {
  padding: 0 24rpx 32rpx;
}

.share-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 69, 19, 0.1);
}

.share-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.share-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.share-title {
  font-size: 36rpx;
  color: #8B4513;
  font-weight: bold;
}

.share-desc {
  font-size: 26rpx;
  color: #5D4037;
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.share-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #FFF8DC;
  border-radius: 12rpx;
}

.stat-item {
  display: flex;
  align-items: center;
}

.level-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.level-name {
  font-size: 28rpx;
  color: #8B4513;
  font-weight: bold;
}

.score-display {
  text-align: right;
}

.score-value {
  font-size: 40rpx;
  color: #DAA520;
  font-weight: bold;
  display: block;
}

.score-label {
  font-size: 22rpx;
  color: #8B4513;
}
