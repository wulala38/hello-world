<view class="container">
  <view class="poster-preview">
    <view class="preview-frame">
      <canvas canvas-id="poster-canvas" class="poster-canvas"></canvas>
    </view>
  </view>

  <view class="action-section">
    <view class="action-buttons">
      <button class="action-btn primary" bindtap="generatePoster" wx:if="{{!posterPath}}">
        <text class="btn-icon">🎨</text>
        <text class="btn-text">生成海报</text>
      </button>

      <button class="action-btn" bindtap="saveToAlbum" wx:if="{{posterPath}}" disabled="{{!posterPath}}">
        <text class="btn-icon">💾</text>
        <text class="btn-text">保存到相册</text>
      </button>

      <button class="action-btn" bindtap="shareToWechat" wx:if="{{posterPath}}">
        <text class="btn-icon">📤</text>
        <text class="btn-text">分享给好友</text>
      </button>
    </view>

    <view class="tips-section">
      <text class="tip-text">💡 海报已自动保存，下次可在相册中找到</text>
    </view>
  </view>

  <view class="share-preview" wx:if="{{posterPath}}">
    <view class="share-card">
      <view class="share-header">
        <text class="share-icon">🎊</text>
        <text class="share-title">分享成果</text>
      </view>
      <text class="share-desc">
        分享你的通关成果到朋友圈，让更多朋友一起体验古代物理的神奇魅力！
      </text>
      <view class="share-stats">
        <view class="stat-item">
          <text class="level-icon">{{level.icon}}</text>
          <text class="level-name">{{level.title}}</text>
        </view>
        <view class="score-display">
          <text class="score-value">{{score}}</text>
          <text class="score-label">积分</text>
        </view>
      </view>
    </view>
  </view>
</view>
