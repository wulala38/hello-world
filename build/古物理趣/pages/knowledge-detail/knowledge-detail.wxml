<view class="container">
  <view class="header-section" style="background: linear-gradient(135deg, {{level.color || '#8B4513'} 0%, {{level.colorLight || '#A0522D'} 100%);">
    <view class="level-info">
      <text class="level-icon">{{level.icon}}</text>
      <text class="level-title">{{level.title}}</text>
    </view>
  </view>

  <view class="content-section">
    <view class="knowledge-card">
      <view class="card-header">
        <text class="knowledge-title">{{knowledgeItem.title}}</text>
        <view class="action-buttons">
          <text class="action-btn" bindtap="toggleFavorite">{{isFavorite ? '❤️' : '🤍'}}</text>
          <text class="action-btn" bindtap="shareKnowledge">📤</text>
        </view>
      </view>
      
      <view class="knowledge-content">
        <text class="content-text">{{knowledgeItem.content}}</text>
      </view>

      <view class="knowledge-diagram">
        <view class="diagram-placeholder">
          <text class="diagram-icon">{{level.icon}}</text>
          <text class="diagram-label">原理图示</text>
        </view>
      </view>
    </view>

    <view class="ancient-story-section">
      <view class="section-header">
        <text class="section-title">📜 典故故事</text>
      </view>
      <view class="story-card">
        <text class="story-title">{{level.ancientExample}}</text>
        <text class="story-content">
          {{level.background}}
        </text>
      </view>
    </view>

    <view class="related-section" wx:if="{{relatedKnowledge.length > 0}}">
      <view class="section-header">
        <text class="section-title">📚 相关知识</text>
      </view>
      <view class="related-list">
        <view class="related-item"
              wx:for="{{relatedKnowledge}}"
              wx:key="index"
              bindtap="viewRelated"
              data-index="{{index}}">
          <text class="related-title">{{item.title}}</text>
          <text class="related-arrow">→</text>
        </view>
      </view>
    </view>

    <view class="quiz-prompt-section">
      <view class="quiz-card">
        <view class="quiz-content">
          <text class="quiz-icon">📝</text>
          <view class="quiz-info">
            <text class="quiz-title">想检验学习成果？</text>
            <text class="quiz-desc">完成答题可获得积分和知识卡片</text>
          </view>
        </view>
        <button class="btn-quiz" bindtap="goToQuiz">开始答题</button>
      </view>
    </view>
  </view>
</view>
