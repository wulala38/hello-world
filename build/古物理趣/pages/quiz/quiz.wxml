<view class="container">
  <view class="quiz-header">
    <view class="quiz-info">
      <text class="level-badge">{{level.icon}} {{level.title}}</text>
      <text class="question-count">第 {{currentIndex + 1}} / {{questions.length}} 题</text>
    </view>
    <view class="quiz-progress">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{(currentIndex / questions.length) * 100}}%"></view>
      </view>
    </view>
    <view class="score-display">
      <text class="score-label">得分</text>
      <text class="score-value">{{score}}</text>
    </view>
  </view>

  <view class="quiz-content" wx:if="{{!showResult && questions.length > 0}}">
    <view class="question-card">
      <view class="question-header">
        <text class="question-icon">❓</text>
        <text class="question-label">请回答</text>
      </view>
      <text class="question-text">{{questions[currentIndex].question}}</text>
    </view>

    <view class="options-list">
      <view class="option-item {{selectedAnswer === index ? (correct ? 'correct' : 'wrong') : ''}} {{answered && index === questions[currentIndex].answer ? 'show-correct' : ''}}"
            wx:for="{{questions[currentIndex].options}}"
            wx:key="index"
            bindtap="selectAnswer"
            data-index="{{index}}">
        <view class="option-marker">
          <text class="marker-text">{{['A', 'B', 'C', 'D'][index]}}</text>
        </view>
        <text class="option-text">{{item}}</text>
        <view class="option-result" wx:if="{{selectedAnswer === index}}">
          {{correct ? '✓' : '✗'}}
        </view>
      </view>
    </view>

    <view class="explanation-card" wx:if="{{answered}}">
      <view class="explanation-header">
        <text class="explanation-icon">{{correct ? '🎉' : '💡'}}</text>
        <text class="explanation-title">{{correct ? '回答正确！' : '答案解析'}}</text>
      </view>
      <text class="explanation-text">{{questions[currentIndex].explanation}}</text>
      
      <button class="btn-next" bindtap="nextQuestion">
        {{currentIndex < questions.length - 1 ? '下一题' : '查看结果'}}
      </button>
    </view>
  </view>

  <view class="result-section" wx:if="{{showResult}}">
    <view class="result-card">
      <view class="result-icon">
        {{score >= totalScore * 0.6 ? '🎊' : '😢'}}
      </view>
      <text class="result-title">
        {{score >= totalScore * 0.6 ? '恭喜通过！' : '继续加油！'}}
      </text>
      
      <view class="result-stats">
        <view class="stat-item">
          <text class="stat-value">{{score}}</text>
          <text class="stat-label">获得积分</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{questions.length}}</text>
          <text class="stat-label">总题数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{score / 20}}</text>
          <text class="stat-label">答对题数</text>
        </view>
      </view>

      <view class="result-actions">
        <button class="btn-secondary" bindtap="retryQuiz">重新答题</button>
        <button class="btn-primary" bindtap="shareResult">分享成果</button>
      </view>

      <view class="knowledge-unlock" wx:if="{{score >= totalScore * 0.6}}">
        <view class="unlock-header">
          <text class="unlock-icon">🔓</text>
          <text class="unlock-title">知识卡片已解锁</text>
        </view>
        <text class="unlock-desc">查看本关的详细知识讲解</text>
        <button class="btn-unlock" bindtap="goToKnowledgeCard">查看知识卡片</button>
      </view>
    </view>
  </view>
</view>
